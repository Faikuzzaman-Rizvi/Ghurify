# Local development settings. Copy this file to .env (which is gitignored) and fill it in:
#
#     Copy-Item .env.example .env
#
# Read by the API (Development only), the DbUp console and Publish-Database.ps1.
# Nested settings use a double underscore: Email__Password is Email:Password.
# Leave a value empty to fall back to appsettings.Development.json.
# Never commit .env, and never put production credentials in it.

# --- Database ---------------------------------------------------------------
# Empty = the docker-compose container (localhost,1433).
Database__ConnectionString=

# --- Blob storage (profile pictures, ID photos, story photos) ----------------
# Point it at the same server as the database: the database keeps the names of the files, so a
# shared database with storage on your own machine shows broken pictures to everyone else, and
# uploads fail whenever your local Azurite is not running.
# Empty = Azurite from docker-compose (127.0.0.1:10000: docker compose up -d azurite).
# The shared ras-x2 server runs Azurite as well. The key below is Azurite's published
# development key, not a secret:
# Storage__ConnectionString=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://ras-x2:10000/devstoreaccount1;
Storage__ConnectionString=

# --- Payments ----------------------------------------------------------------
# Development pays through the SSLCommerz sandbox with its public test store (testbox / qwerty),
# so nothing is needed here for a demo. To use your own sandbox store from
# https://developer.sslcommerz.com/registration/, fill these in. Payments__Provider=fake pays on a
# built-in pretend page instead, offline. The sandbox returns the traveller to the API at
# Payments__ApiBaseUrl (default http://localhost:5199), which must be reachable from the browser.
Payments__Provider=
Payments__SslCommerz__StoreId=
Payments__SslCommerz__StorePassword=

# --- Email (sign-in codes) --------------------------------------------------
# Gmail: turn on 2-Step Verification, then create a 16-character App Password at
# https://myaccount.google.com/apppasswords (your normal Google password will not work).
# Leave UserName or Password empty and Development prints sign-in codes to the API console.
Email__Host=smtp.gmail.com
Email__Port=587
Email__UserName=
Email__Password=
Email__FromAddress=
