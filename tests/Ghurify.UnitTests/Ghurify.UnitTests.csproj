<Project Sdk="Microsoft.NET.Sdk">

  <!-- No database. Domain rules, handlers with hand-made fakes, validators,
       and DatabaseProjectFileTests which only reads files from disk. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 runs on Microsoft.Testing.Platform; the .NET 10 SDK requires this opt-in
         for `dotnet test` to drive it instead of the retired VSTest path. -->
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ghurify.Domain\Ghurify.Domain.csproj" />
    <ProjectReference Include="..\..\src\Ghurify.Application\Ghurify.Application.csproj" />
    <!-- For the composition guard below: the development email sender logs the one-time code,
         so a test must prove it cannot be resolved outside Development. -->
    <ProjectReference Include="..\..\src\Ghurify.Infrastructure\Ghurify.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- Produces the TRX report CI uploads and inspects. -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
