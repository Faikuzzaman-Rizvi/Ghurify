<Project Sdk="Microsoft.NET.Sdk">

  <!-- Real SQL Server in Testcontainers, schema deployed from the dacpac with DacFx,
       then DbUp, then endpoints through WebApplicationFactory. Needs Docker. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 runs on Microsoft.Testing.Platform; the .NET 10 SDK requires this opt-in
         for `dotnet test` to drive it instead of the retired VSTest path. -->
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ghurify.Api\Ghurify.Api.csproj" />
    <ProjectReference Include="..\..\src\Ghurify.Infrastructure\Ghurify.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Ghurify.DatabaseUpdate\Ghurify.DatabaseUpdate.csproj" />
    <!-- Not referenced for its API: this makes the dacpac build before the tests run. -->
    <ProjectReference Include="..\..\src\Database\Ghurify.Database\Ghurify.Database.sqlproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Produces the TRX report CI uploads and inspects. -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Microsoft.SqlServer.DacFx" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
