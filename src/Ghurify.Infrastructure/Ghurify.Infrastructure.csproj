<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dapper repositories, external gateways (payments, SMS, e-KYC, storage),
       Hangfire jobs and Serilog configuration. -->

  <ItemGroup>
    <ProjectReference Include="..\Ghurify.Application\Ghurify.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.SqlServer" />
    <PackageReference Include="Hangfire.NetCore" />
    <!-- Lifts Hangfire's vulnerable transitive Newtonsoft.Json; see Directory.Packages.props. -->
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- The logo and banner travel inside every account email (cid: links), so they ship in the
         assembly instead of being fetched from a server when the email is opened. -->
    <EmbeddedResource Include="Email/Assets/*.png;Email/Assets/*.jpg" />
  </ItemGroup>

</Project>
