{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    },
    // Console only. Cleared deliberately: appsettings.json turns the rolling file on for deployed
    // environments, and the integration suite starts the host many times in parallel, which would
    // otherwise have them all writing to the same file.
    "FilePath": ""
  },

  // Defaults to the docker-compose container, whose password is a local-only throwaway.
  // A shared or personal server is chosen in the gitignored .env at the repository root
  // (Database__ConnectionString=...; template in .env.example), never by editing this file, so
  // no real credential is ever committed. The DbUp console and Publish-Database.ps1 read it too.
  "Database": {
    "ConnectionString": "Server=ras-x2,1433;Database=Ghurify;User Id=sa;Password=Ghurify_Local_Dev_1;TrustServerCertificate=True;Encrypt=False;"
  },

  // Azurite from docker-compose. The well-known development account, not a secret. Deployed
  // environments set Storage__ConnectionString from Key Vault; without it uploads are unavailable.
  "Storage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },

  // The SSLCommerz sandbox, so a demo goes through a real hosted payment page (test cards and
  // test mobile banking, no real money). "testbox" / "qwerty" is the public test store from
  // SSLCommerz's own developer docs, not a secret. Your own sandbox store, or "fake" to work
  // offline, goes in .env (Payments__Provider, Payments__SslCommerz__StoreId/StorePassword).
  // Live credentials only ever come from Key Vault, and startup refuses the sandbox in Production.
  "Payments": {
    "Provider": "sslcommerz",
    "SslCommerz": {
      "StoreId": "testbox",
      "StorePassword": "qwerty",
      "Sandbox": true
    }
  },

  "Redis": {
    "ConnectionString": "ras-x2:6379"
  },

  "Email": {
    // Non-secret defaults only. UserName and Password go in .env (Email__UserName,
    // Email__Password: a Gmail App Password), NEVER here. Without them the API writes the
    // sign-in code to the console in Development, so a fresh clone works with no mail account.
    //
    // Gmail by default because it actually delivers. Test mailboxes (Mailtrap, Ethereal)
    // accept mail and never deliver it, so codes "send" fine and never arrive; set
    // Email__Host in .env only if you want one of those on purpose.
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "FromName": "GhuriFiri"
  },

  "Identity": {
    // Local development only, and worthless outside this machine: they sign and hash nothing
    // that exists anywhere else. Staging and production supply both from Key Vault / App
    // Service settings, and this file is never published (CopyToPublishDirectory=Never).
    // Startup fails if either is missing or shorter than 32 characters.
    "OtpPepper": "ghurify-local-dev-otp-pepper-not-a-secret",
    "JwtSigningKey": "ghurify-local-dev-jwt-signing-key-not-a-secret"
  },

  "Verification": {
    // Local development only, like the Identity secrets above. Deployed environments read both
    // from Key Vault; startup fails if either is missing or shorter than 32 characters.
    "NidPepper": "ghurify-local-dev-nid-pepper-not-a-secret",
    "CallbackSecret": "ghurify-local-dev-ekyc-callback-secret-not-a-secret"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  }
}
