<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Local secrets (connection strings, signing keys) live outside the repo, in the
         per-user secrets store this id points at. Never put real credentials in
         appsettings*.json. -->
    <UserSecretsId>170067e9-9eba-4275-bfc6-b0290584fd37</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ghurify.Infrastructure\Ghurify.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Settings are supplied by user-secrets locally and by App Service settings / Key Vault
         when deployed, so the published output must never carry a checked-in appsettings file. -->
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ghurify.IntegrationTests" />
  </ItemGroup>

</Project>
