<Project Sdk="Microsoft.NET.Sdk">

  <!-- DbUp console. Data only: it never creates, alters or drops schema objects. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ghurify.DatabaseUpdate</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dbup-sqlserver" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>

  <ItemGroup>
    <!-- The .env reader, shared with the API by linking the one source file. A project
         reference would drag Dapper, MailKit and the rest of Infrastructure into a console
         that only needs a connection string. -->
    <Compile Include="..\Ghurify.Infrastructure\Configuration\DotEnvFile.cs" Link="Configuration\DotEnvFile.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scripts ship inside the assembly so the console is a single self-contained deploy step. -->
    <EmbeddedResource Include="Scripts\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.json supplies Database:ConnectionString for local runs.
         Pipelines use the GHURIFY_DB environment variable instead. -->
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
